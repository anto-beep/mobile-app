<?xml version="1.0" encoding="utf-8"?>
<!--
  Wayly Android Network Security Config (Phase 5 hardening).
  - Disables cleartext HTTP traffic globally (TLS only).
  - Trusts ONLY system CAs; user-installed CAs are NOT trusted.
    This neutralises corporate-proxy / debug-proxy MITM on installed builds.
  - The single cleartext exception is `localhost` so on-device Metro/dev
    tooling (Expo Go on emulator) keeps working when explicitly developing
    against a local backend.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

  <!-- Allow cleartext to localhost only (dev/Metro). -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
