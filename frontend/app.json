{
  "expo": {
    "name": "Wayly",
    "slug": "wayly-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wayly",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "au.wayly.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Snap a photo of your statement to upload it",
        "NSPhotoLibraryUsageDescription": "Pick a saved statement photo to upload",
        "ITSAppUsesNonExemptEncryption": false,
        "UIAppFonts": [
          "Fraunces-Variable.ttf",
          "Inter-VariableFont.ttf",
          "IBMPlexMono-Regular.ttf"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FBF8F3"
      },
      "edgeToEdgeEnabled": true,
      "package": "au.wayly.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#0E4D52",
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#FBF8F3"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Wayly uses the camera to scan your aged-care statements."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Wayly accesses your photos to upload statement images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0E4D52"
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Fraunces-Variable.ttf",
            "./assets/fonts/Inter-VariableFont.ttf",
            "./assets/fonts/IBMPlexMono-Regular.ttf"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
